{
  "name": "couple-app",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "dev": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "doctor": "expo install --check",
    "verify": "node scripts/verify-architecture.mjs && node scripts/sync-backend.mjs --check",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "bundle:android": "expo export --platform android --output-dir .expo-export-audit-android",
    "bundle:ios": "expo export --platform ios --output-dir .expo-export-audit-ios",
    "lint": "expo lint",
    "types:generate": "node scripts/generate-database-types.mjs",
    "types:check": "node scripts/generate-database-types.mjs --check",
    "backend:typecheck": "npm exec --yes --package=deno@2.9.6 -- deno check --config supabase/functions/deno.json --frozen supabase/functions/push/index.ts supabase/functions/maintenance/index.ts"
  },
  "dependencies": {
    "@react-navigation/bottom-tabs": "^6.5.20",
    "@react-navigation/native": "^6.1.17",
    "@supabase/supabase-js": "^2.110.7",
    "expo": "~57.0.12",
    "expo-battery": "~57.0.1",
    "expo-constants": "~57.0.10",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.11",
    "expo-image-manipulator": "~57.0.9",
    "expo-image-picker": "~57.0.9",
    "expo-location": "~57.0.9",
    "expo-notifications": "~57.0.10",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.9",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-maps": "1.27.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.1",
    "typescript": "~6.0.3",
    "@electric-sql/pglite": "^0.5.8"
  }
}
