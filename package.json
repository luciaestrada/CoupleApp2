{
  "name": "couple-app",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "dev": "expo start --dev-client",
    "android": "expo run:android",
    "android:release:apk": "node scripts/android-release.mjs apk",
    "android:release:aab": "node scripts/android-release.mjs aab",
    "ios": "expo run:ios",
    "doctor": "expo install --check",
    "verify": "node scripts/verify-architecture.mjs && node scripts/sync-backend.mjs --check",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "bundle:android": "expo export --platform android --output-dir .expo-export-audit-android",
    "bundle:ios": "expo export --platform ios --output-dir .expo-export-audit-ios",
    "lint": "expo lint",
    "types:generate": "node scripts/generate-database-types.mjs",
    "types:check": "node scripts/generate-database-types.mjs --check",
    "backend:audit": "node scripts/audit-backend.mjs",
    "backend:typecheck": "npm exec --yes --package=deno@2.9.6 -- deno check --config supabase/functions/deno.json --frozen supabase/functions/push/index.ts supabase/functions/maintenance/index.ts"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-navigation/bottom-tabs": "^6.5.20",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/native-stack": "^6.11.0",
    "@supabase/supabase-js": "^2.110.7",
    "expo": "~57.0.27",
    "expo-background-task": "~57.0.21",
    "expo-battery": "~57.0.3",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.0",
    "expo-haptics": "~57.0.3",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-location": "~57.0.20",
    "expo-notifications": "~57.0.22",
    "expo-sensors": "~57.0.3",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.9",
    "expo-video": "~57.0.5",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-webview": "^13.16.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^26.6.4",
    "@types/react": "~19.2.4",
    "@types/react-test-renderer": "^19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "leaflet": "^1.9.4",
    "prettier": "^3.9.9",
    "react-test-renderer": "^19.2.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
